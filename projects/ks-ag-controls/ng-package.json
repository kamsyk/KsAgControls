{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/ks-ag-controls",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "ks-ag-controls.css",
      "input": "src/styles",
      "output": "styles"
    },
    {
      "glob": "LICENSE",
      "input": "licenses/material-symbols",
      "output": "licenses/material-symbols"
    }
  ]
}
